{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glint-spike",
  "version": "0.0.0",
  "identifier": "dev.glint.spike",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "url": "index.html",
        "width": 680,
        "height": 120,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
