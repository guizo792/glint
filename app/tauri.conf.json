{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "version": "0.1.0",
  "identifier": "dev.glint.launcher",
  "build": { "frontendDist": "./ui/dist" },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Glint",
        "url": "index.html",
        "width": 680,
        "height": 84,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": true,
        "backgroundColor": "#1e1f26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
